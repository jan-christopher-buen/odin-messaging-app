{
  "name": "@signal/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "prisma": "^7.0.0",
    "supertest": "^7.1.0"
  }
}
