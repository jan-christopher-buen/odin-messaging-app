generator client {
  provider = "prisma-client-js"
  output = "../generated/client"
}
datasource db {
  provider = "postgresql"
}
model User {
  id Int @id @default(autoincrement())
  username String @unique @db.VarChar(24)
  displayName String @db.VarChar(50)
  bio String @default("") @db.VarChar(160)
  passwordHash String
  firstConversations Conversation[] @relation("First")
  secondConversations Conversation[] @relation("Second")
  messages Message[]
}
model Conversation {
  id Int @id @default(autoincrement())
  firstId Int
  secondId Int
  first User @relation("First", fields: [firstId], references: [id])
  second User @relation("Second", fields: [secondId], references: [id])
  updatedAt DateTime @default(now())
  messages Message[]
  @@unique([firstId, secondId])
  @@index([secondId, updatedAt, id])
  @@index([firstId, updatedAt, id])
}
model Message {
  id Int @id @default(autoincrement())
  conversationId Int
  senderId Int
  text String @db.VarChar(4000)
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])
  @@index([conversationId, id])
}
